# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/clinic_crm"

# JWT
JWT_ACCESS_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_strong_random_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP - ready architecture)
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Clinic CRM <noreply@cliniccrm.com>"

# SMS Integration Ready Architecture
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# WhatsApp Integration Ready Architecture
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
